+  if ((uintptr_t)ShellExecuteW(NULL, L"open", path.c_str(), NULL, NULL,
+                               SW_SHOWNORMAL) > 32)
+    return true;
+  // ShellExecuteW can fail silently inside a TSF host process (association
+  // lookup denied, no default browser in that context, ...). Fall back to
+  // asking the shell itself to start the file.
+  std::wstring cmdline = L"cmd.exe /c start \"\" \"" + path + L"\"";
+  STARTUPINFOW si = {};
+  si.cb = sizeof(si);
+  PROCESS_INFORMATION pi = {};
+  if (CreateProcessW(NULL, cmdline.data(), NULL, NULL, FALSE, CREATE_NO_WINDOW,
+                     NULL, NULL, &si, &pi)) {
+    CloseHandle(pi.hThread);
+    CloseHandle(pi.hProcess);
+    return true;
+  }
+  return false;
 }
 
