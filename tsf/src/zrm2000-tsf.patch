+// Same lookup as the "user folder" menu item: the configured RimeUserDir,
+// falling back to %APPDATA%\Rime. (WeaselUserDataPath() lives in the server
+// side and is not linked into the TSF.)
+static std::wstring UserDataDir() {
+  std::wstring dir;
+  if (FAILED(RegGetStringValue(HKEY_CURRENT_USER, L"Software\\Rime\\Weasel",
+                               L"RimeUserDir", dir)) ||
+      dir.empty()) {
+    WCHAR path[MAX_PATH] = {0};
+    ExpandEnvironmentStringsW(L"%AppData%\\Rime", path, _countof(path));
+    dir = path;
+  }
+  return dir;
+}
